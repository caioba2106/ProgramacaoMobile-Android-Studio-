<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo"
    tools:context=".CalculadoraActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/titulo_principal"
        android:textSize="35sp"
        android:textColor="@color/cor_textos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="@string/resultado_final"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/cor_textos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_numero2" />

    <Button
        android:id="@+id/btn_somar"
        android:layout_width="135dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:text="@string/somar"
        android:textSize="25sp"
        android:backgroundTint="@color/cor_botões"
        android:textColor="@color/cor_botões_texto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.152"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_resultado" />

    <Button
        android:id="@+id/btn_multiplicar"
        android:layout_width="135dp"
        android:layout_height="60dp"
        android:layout_marginTop="36dp"
        android:text="@string/multiplicar"
        android:textSize="20sp"
        android:backgroundTint="@color/cor_botões"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.152"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_somar" />

    <Button
        android:id="@+id/btn_dividir"
        android:layout_width="135dp"
        android:layout_height="60dp"
        android:layout_marginTop="36dp"
        android:text="@string/dividir"
        android:textSize="25sp"
        android:backgroundTint="@color/cor_botões"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.851"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_subtrair" />

    <Button
        android:id="@+id/btn_subtrair"
        android:layout_width="135dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:text="@string/subtrair"
        android:textSize="25sp"
        android:backgroundTint="@color/cor_botões"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.851"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_resultado" />

    <EditText
        android:id="@+id/edt_numero1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="@string/numero1_hint"
        android:textColor="@color/cor_texto_hint"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <EditText
        android:id="@+id/edt_numero2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="@string/numero2_hint"
        android:textColor="@color/cor_texto_hint"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_numero1" />
</androidx.constraintlayout.widget.ConstraintLayout>
