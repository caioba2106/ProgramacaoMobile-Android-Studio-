package com.example.weathernow.fragments;

import android.content.Intent;
import android.os.Bundle;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;
import android.widget.Toast;
import androidx.annotation.NonNull;
import androidx.annotation.Nullable;
import androidx.fragment.app.Fragment;
import androidx.recyclerview.widget.LinearLayoutManager;
import androidx.recyclerview.widget.RecyclerView;
import com.example.weathernow.NovoAlertaActivity;
import com.example.weathernow.R;
import com.example.weathernow.adapter.AlertaAdapter;
import com.example.weathernow.api.ClimaResponse;
import com.example.weathernow.api.RetrofitClient;
import com.example.weathernow.model.Alerta;
import java.util.ArrayList;
import java.util.List;
import retrofit2.Call;
import retrofit2.Callback;
import retrofit2.Response;

public class InicioFragment extends Fragment {

    @Nullable
    @Override
    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container, @Nullable Bundle savedInstanceState) {
        View view = inflater.inflate(R.layout.fragment_inicio, container, false);

        RecyclerView recyclerView = view.findViewById(R.id.recycler_alertas);
        recyclerView.setLayoutManager(new LinearLayoutManager(getContext()));

        List<Alerta> alertas = new ArrayList<>();
        alertas.add(new Alerta("Casa", "Indaiatuba - SP", 50, "1h antes", true));
        alertas.add(new Alerta("Trabalho", "Indaiatuba - SP", 40, "2h antes", true));
        alertas.add(new Alerta("Faculdade", "Indaiatuba - SP", 75, "30m antes", true));

        AlertaAdapter adapter = new AlertaAdapter(alertas);
        recyclerView.setAdapter(adapter);

        buscarClimaReal();
        
        view.findViewById(R.id.btn_adicionar_alerta).setOnClickListener(v -> {
            Intent intent = new Intent(getActivity(), NovoAlertaActivity.class);
            startActivity(intent);
        });

        return view;
    }

    private void buscarClimaReal(){
        RetrofitClient.obterServico().obterPrevisao(-23.09, -47.21, true)
            .enqueue(new Callback<ClimaResponse>(){

            @Override
            public void onResponse(Call<ClimaResponse> call, Response<ClimaResponse> response){
                if(response.isSuccessful() && response.body() != null){
                    ClimaResponse.CurrentWeather clima = response.body().getCurrentWeather();
                    double temperatura = clima.getTemperature();
                }
            }

            @Override
            public void onFailure(Call<ClimaResponse> call, Throwable t){
                if(getContext() != null){
                    Toast.makeText(getContext(), "Erro ao carregar clima da API", Toast.LENGHT_SHORT).show();
                }
            }
        });
    }
}
