package com.example.weathernow.data;

import androidx.room.Dao;
import androidx.room.Delete;
import androidx.room.Insert;
import androidx.room.Query;
import androidx.room.Update;
import java.util.List;

@Dao
public interface AlertaDao {

    @Insert
    void inserir(AlertaEntity alerta);

    @Update
    void atualizar(AlertaEntity alerta);

    @Delete
    void apagar(AlertaEntity alerta);

    @Query("SELECT * FROM tabela_alertas")
    List<AlertaEntity> obterTodos();
}
