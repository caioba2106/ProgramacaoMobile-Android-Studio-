<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_calculadora_notas"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/edt_p1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nota P1 (peso 30%)"
        android:textColorHint="@color/cor_texto_hint"
        android:textColor="@color/cor_texto_hint"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/edt_p2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nota P2 (peso 35%)"
        android:textColorHint="@color/cor_texto_hint"
        android:textColor="@color/cor_texto_hint"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/edt_p1"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edt_pi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nota PI (peso 20%)"
        android:textColorHint="@color/cor_texto_hint"
        android:textColor="@color/cor_texto_hint"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/edt_p2"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edt_atividades"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nota Atividades (peso 15%)"
        android:textColorHint="@color/cor_texto_hint"
        android:textColor="@color/cor_texto_hint"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/edt_pi"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_calcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calcular Média"
        android:backgroundTint="@color/cor_botões"
        app:layout_constraintTop_toBottomOf="@id/edt_atividades"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/txt_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Média: "
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/btn_calcular"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/txt_situacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Situação: "
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txt_media"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
