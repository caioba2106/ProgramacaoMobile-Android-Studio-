<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESULTADO CORPORAL"
            android:textColor="#00D9A5"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <ImageView
            android:layout_width="160dp"
            android:layout_height="220dp"
            android:src="@drawable/silhueta_corporal"
            android:scaleType="fitCenter"
            android:contentDescription="Silhueta corporal"/>

        <ImageView
            android:id="@+id/imagem_resultado"
            android:layout_width="190dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:scaleType="fitCenter"
            android:contentDescription="Foto utilizada na demonstração"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SILHUETA CORPORAL"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indicadores demonstrativos"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1D2B36"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gordura corporal"
                android:textColor="#FFFFFF"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/txt_gordura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="22%"
                android:textColor="#00D9A5"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45545E"
                android:layout_marginVertical="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Massa muscular"
                android:textColor="#FFFFFF"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/txt_muscular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="38%"
                android:textColor="#00D9A5"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45545E"
                android:layout_marginVertical="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Massa magra"
                android:textColor="#FFFFFF"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/txt_massa_magra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="60,0 kg"
                android:textColor="#00D9A5"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45545E"
                android:layout_marginVertical="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IMC"
                android:textColor="#FFFFFF"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/txt_imc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="23,5"
                android:textColor="#00D9A5"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45545E"
                android:layout_marginVertical="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Peso corporal"
                android:textColor="#FFFFFF"
                android:textSize="17sp"/>

            <TextView
                android:id="@+id/txt_peso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="75,0 kg"
                android:textColor="#00D9A5"
                android:textSize="28sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atenção: resultados fictícios para demonstração acadêmica. A fotografia não calcula a composição corporal."
            android:textColor="#FFC107"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btn_voltar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VOLTAR"
            android:backgroundTint="#00B98B"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp"/>

    </LinearLayout>
</ScrollView>
