
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BODYSCAN"
            android:textColor="#00D9A5"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avaliação Corporal"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_marginTop="10dp"/>

        <ImageView
            android:id="@+id/imagem_corpo"
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:layout_marginTop="35dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Foto corporal"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posicione seu corpo inteiro em frente à câmera e tire uma foto."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btn_capturar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CAPTURAR FOTO"
            android:textSize="18sp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#00B98B"/>

    </LinearLayout>
</ScrollView>
