
package com.example.bodyscan;

import android.content.Intent;
import android.os.Bundle;
import android.os.Handler;
import android.widget.ProgressBar;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

public class ProcessamentoActivity extends AppCompatActivity {

    TextView txtProcessando;
    ProgressBar progresso;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_processamento);

        txtProcessando = findViewById(R.id.txt_processando);
        progresso = findViewById(R.id.progresso);

        byte[] foto = getIntent().getByteArrayExtra("foto");

        txtProcessando.setText(
                "Analisando sua imagem corporal...");

        progresso.setProgress(0);

        new Handler().postDelayed(() -> {

            progresso.setProgress(100);

            Intent tela = new Intent(ProcessamentoActivity.this, ResultadoActivity.class);

            tela.putExtra("foto", foto);

            startActivity(tela);

            finish();

        }, 3000);
    }
}
